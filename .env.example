# Local/Nginx: /api mantém a API na mesma origem. Na Vercel, use VITE_API_URL abaixo.
VITE_API_BASE_URL=/api

# Vercel: set the confirmed HTTPS backend origin, without /api or /api/v1.
# VITE_API_URL takes precedence over VITE_API_BASE_URL. It contains no secrets.
# VITE_API_URL=https://your-staging-backend.onrender.com

# Destino do proxy do Vite. Esta variável só é usada pelo servidor de desenvolvimento.
VITE_API_PROXY_TARGET=http://localhost:8080

# URL do documento OpenAPI usada por `pnpm api:generate`.
OPENAPI_URL=http://localhost:8080/v3/api-docs
