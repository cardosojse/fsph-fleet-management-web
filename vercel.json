{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm exec --yes --package=pnpm@11.25.0 -- pnpm install --frozen-lockfile --prefer-offline",
  "buildCommand": "node scripts/check-deploy-env.mjs && npm run build",
  "outputDirectory": "dist",
  "git": {
    "deploymentEnabled": false
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
